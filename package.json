{
  "name": "khata-coin-purse",
  "version": "1.0.0",
  "private": true,
  "description": "The Coin Purse: an LLM research agent with a $5 test-USDC purse that can pay x402 endpoints but cannot be talked out of its limits.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run scan:credentials",
    "sellers": "tsx --env-file-if-exists=.env scripts/sellers.ts",
    "agent": "tsx --env-file-if-exists=.env scripts/agent.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "demo:headless": "tsx --env-file-if-exists=.env scripts/demo.ts --headless",
    "ui": "tsx --env-file-if-exists=.env scripts/ui.ts",
    "scan:credentials": "tsx scripts/credential-scan.ts"
  },
  "dependencies": {
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "viem": "^2.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "express": "^4.21.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
